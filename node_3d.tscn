[sub_resource type="Shader" id="Shader_city_buildings"]
code = "shader_type spatial;\nrender_mode diffuse_burley, cull_back;\n\nuniform vec4 base_color : source_color;\nuniform vec4 window_color : source_color = vec4(0.08, 0.22, 0.34, 1.0);\nuniform float window_strength : hint_range(0.0, 1.0) = 0.42;\n\nvoid fragment() {\n    vec2 cell = vec2(UV.x * 8.0, UV.y * 16.0);\n    vec2 local = fract(cell);\n    float horizontal_gap = step(0.16, local.x) * step(local.x, 0.88);\n    float vertical_gap = step(0.18, local.y) * step(local.y, 0.84);\n    float windows = horizontal_gap * vertical_gap;\n    vec3 facade = mix(base_color.rgb, window_color.rgb, windows * window_strength);\n    ALBEDO = facade;\n    ROUGHNESS = 0.88;\n    EMISSION = window_color.rgb * windows * 0.035;\n}\n"

