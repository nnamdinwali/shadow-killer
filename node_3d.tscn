[sub_resource type="Shader" id="Shader_clouds"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_mix;

uniform vec4 cloud_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float opacity : hint_range(0.0, 1.0) = 0.7;

float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + vec2(1.0, 0.0));
    float c = hash21(i + vec2(0.0, 1.0));
    float d = hash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float cloud_fbm(vec2 p) {
    float value = 0.0;
    float amplitude = 0.55;
    for (int i = 0; i < 4; i++) {
        value += noise(p) * amplitude;
        p = p * 2.02 + vec2(13.7, 7.1);
        amplitude *= 0.5;
    }
    return value;
}

void fragment() {
    vec2 p = UV * vec2(5.2, 2.35);
    p.x += TIME * 0.004;
    float base = cloud_fbm(p);
    float detail = noise(p * 3.4 + 8.0) * 0.22;
    float cloud = smoothstep(0.51, 0.69, base + detail);
    float soft_edges = smoothstep(0.02, 0.16, UV.x) * smoothstep(0.98, 0.84, UV.x);
    soft_edges *= smoothstep(0.02, 0.20, UV.y) * smoothstep(0.98, 0.80, UV.y);
    ALBEDO = cloud_color.rgb;
    ALPHA = cloud * soft_edges * opacity;
}
"

