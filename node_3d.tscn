[sub_resource type="Shader" id="Shader_clouds"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, depth_draw_never, blend_mix;\n\nuniform vec4 cloud_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);\nuniform float opacity : hint_range(0.0, 1.0) = 0.42;\n\nfloat hash21(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\nfloat noise(vec2 p) {\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = hash21(i);\n    float b = hash21(i + vec2(1.0, 0.0));\n    float c = hash21(i + vec2(0.0, 1.0));\n    float d = hash21(i + vec2(1.0, 1.0));\n    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\nfloat cloud_fbm(vec2 p) {\n    float value = 0.0;\n    float amplitude = 0.55;\n    for (int i = 0; i < 3; i++) {\n        value += noise(p) * amplitude;\n        p = p * 2.02 + vec2(13.7, 7.1);\n        amplitude *= 0.5;\n    }\n    return value;\n}\n\nvoid fragment() {\n    vec2 p = UV * vec2(4.5, 2.0);\n    p.x += TIME * 0.004;\n    float base = cloud_fbm(p);\n    float detail = noise(p * 3.0 + 8.0) * 0.12;\n    float cloud = smoothstep(0.43, 0.64, base + detail);\n    float soft_edges = smoothstep(0.02, 0.16, UV.x) * smoothstep(0.98, 0.84, UV.x);\n    soft_edges *= smoothstep(0.02, 0.20, UV.y) * smoothstep(0.98, 0.80, UV.y);\n    ALBEDO = cloud_color.rgb;\n    ALPHA = cloud * soft_edges * opacity;\n}\n"

